# Получите токен у @BotFather в Telegram и укажите его здесь (или прямо в веб-панели управления)
BOT_TOKEN=

# Публичный HTTPS URL для Telegram Mini App (WebApp кнопку). Если не указан, определяется автоматически
WEBAPP_URL=

# Настройки сервера
HOST=0.0.0.0
PORT=8000

# Путь к SQLite базе данных
DATABASE_PATH=data/nexus.db
